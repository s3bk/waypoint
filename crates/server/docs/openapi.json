  "/api/graphs/{graph}/apply": {
   "post": {
    "summary": "Apply a batch of ops atomically (editor key)",
    "security": [
     {
      "bearer": []
     }
    ],
    "parameters": [
     {
      "name": "graph",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Waypoint-Actor",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "description": "key role too low"
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "ops"
        ],
        "properties": {
         "label": {
          "type": "string"
         },
         "ops": {
          "type": "array",
          "items": {
           "oneOf": [
            {
             "type": "object",
             "required": [
              "op",
              "title"
             ],
             "properties": {
              "op": {
               "const": "create_node"
              },
              "title": {
               "type": "string"
              },
              "depends_on": {
               "type": "array",
               "items": {
                "type": "string",
                "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
               }
              },
              "dependants": {
               "type": "array",
               "items": {
                "type": "string",
                "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
               }
              },
              "x": {
               "type": "integer"
              },
              "y": {
               "type": "integer"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node",
              "title"
             ],
             "properties": {
              "op": {
               "const": "rename_node"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "title": {
               "type": "string"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node"
             ],
             "properties": {
              "op": {
               "const": "delete_node"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "from",
              "to"
             ],
             "properties": {
              "op": {
               "const": "link"
              },
              "from": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "to": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "from",
              "to"
             ],
             "properties": {
              "op": {
               "const": "unlink"
              },
              "from": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "to": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node",
              "x",
              "y"
             ],
             "properties": {
              "op": {
               "const": "move_node"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "x": {
               "type": "integer"
              },
              "y": {
               "type": "integer"
              },
              "with_subtree": {
               "type": "boolean"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node",
              "body"
             ],
             "properties": {
              "op": {
               "const": "set_note"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "body": {
               "type": "string"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node",
              "text"
             ],
             "properties": {
              "op": {
               "const": "append_note"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "text": {
               "type": "string"
              }
             }
            }
           ],
           "discriminator": {
            "propertyName": "op"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
