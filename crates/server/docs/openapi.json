        ],
        "properties": {
         "title": {
          "type": "string"
         }
        }
       }
      }
     }
    }
   }
  }
 },
 "components": {
  "securitySchemes": {
   "bearer": {
    "type": "http",
    "scheme": "bearer",
    "description": "wp_owner_/wp_editor_/wp_viewer_ key; also accepted as ?key="
   }
  },
  "responses": {
   "Unauthorized": {
    "description": "missing or wrong key",
    "content": {
     "application/json": {
      "schema": {
       "type": "object",
       "properties": {
        "error": {
         "type": "string"
        },
        "docs": {
         "type": "string"
        }
       }
      }
     }
    }
   }
  }
 }
}