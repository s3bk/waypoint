  "/api/graphs/{graph}/nodes/{node}/neighbours": {
   "get": {
    "summary": "Nodes reachable from a node",
    "security": [
     {
      "bearer": []
     }
    ],
    "parameters": [
     {
      "name": "graph",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "node",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "direction",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "both",
        "dependencies",
        "dependants"
       ]
      }
     },
     {
      "name": "depth",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "ok",
      "content": {
       "application/json": {}
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
  "/api/graphs/{graph}/conflicts": {
