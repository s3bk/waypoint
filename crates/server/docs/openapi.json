{
 "openapi": "3.1.0",
 "info": {
  "title": "Waypoint API",
  "version": "1",
  "description": "Shared dependency graph. Authenticate with a graph key as a bearer token, or ?key= on any request. Docs for agents: /llms.txt"
 },
 "paths": {
  "/api/graphs": {
   "post": {
    "summary": "Generate a new set of owner/editor/viewer keys (no auth)",
    "responses": {
     "200": {
      "description": "keys"
     }
    }
   }
  },
  "/api/session": {
   "get": {
    "summary": "Role, graph ID and shareable keys for the presented key",
    "security": [
     {
      "bearer": []
     }
    ],
    "responses": {
     "200": {
      "description": "{role, graph, exists, keys}"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     }
    }
   }
  },
