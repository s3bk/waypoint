  "/api/graphs/{graph}/apply": {
   "post": {
    "summary": "Apply a batch of ops atomically (editor key)",
    "security": [
     {
      "bearer": []
     }
    ],
    "parameters": [
     {
      "name": "graph",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "X-Waypoint-Actor",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "what the caller calls itself; may repeat, proves nothing"
     },
     {
      "name": "X-Waypoint-Peer",
      "in": "header",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "the caller's id for this session; keys its undo history"
     }
    ],
    "responses": {
     "200": {
      "description": "ok"
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "description": "key role too low"
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "ops"
        ],
        "properties": {
         "label": {
          "type": "string"
         },
         "ops": {
          "type": "array",
          "items": {
           "oneOf": [
            {
             "type": "object",
             "required": [
              "op",
              "title"
             ],
             "properties": {
              "op": {
               "const": "create_node"
              },
              "title": {
               "type": "string"
              },
              "destinations": {
               "type": "array",
               "items": {
                "type": "string",
                "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
               }
              },
              "sources": {
               "type": "array",
               "items": {
                "type": "string",
                "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
               }
              },
              "x": {
               "type": "integer"
              },
              "y": {
               "type": "integer"
              },
              "node_type": {
               "type": "string",
               "description": "name of a node type"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node",
              "title"
             ],
             "properties": {
              "op": {
               "const": "rename_node"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "title": {
               "type": "string"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node"
             ],
             "properties": {
              "op": {
               "const": "delete_node"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "from",
              "to"
             ],
             "properties": {
              "op": {
               "const": "link"
              },
              "from": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "to": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "edge_type": {
               "type": "string",
               "description": "name of an edge type; an existing link is changed to it"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "from",
              "to"
             ],
             "properties": {
              "op": {
               "const": "unlink"
              },
              "from": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "to": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node",
              "x",
              "y"
             ],
             "properties": {
              "op": {
               "const": "move_node"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "x": {
               "type": "integer"
              },
              "y": {
               "type": "integer"
              },
              "with_destinations": {
               "type": "boolean"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node",
              "body"
             ],
             "properties": {
              "op": {
               "const": "set_note"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "body": {
               "type": "string"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node",
              "text"
             ],
             "properties": {
              "op": {
               "const": "append_note"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "text": {
               "type": "string"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "node",
              "node_type"
             ],
             "properties": {
              "op": {
               "const": "set_node_type"
              },
              "node": {
               "type": "string",
               "description": "key (\"#12\" or \"12\"), UUID, or \"$N\" for the node created by op N of the same batch"
              },
              "node_type": {
               "type": "string",
               "description": "type name, or \"default\""
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "name"
             ],
             "properties": {
              "op": {
               "const": "upsert_node_type"
              },
              "name": {
               "type": "string"
              },
              "new_name": {
               "type": "string"
              },
              "shape": {
               "type": "string",
               "enum": [
                "rect",
                "pill",
                "ellipse",
                "hexagon",
                "rhombus"
               ]
              },
              "bg": {
               "type": "string",
               "description": "#rrggbb"
              },
              "fg": {
               "type": "string",
               "description": "#rrggbb"
              },
              "border": {
               "type": "string",
               "description": "#rrggbb"
              },
              "border_width": {
               "type": "integer",
               "description": "clamped to 0-10"
              },
              "corners": {
               "type": "string",
               "enum": [
                "round",
                "square"
               ],
               "description": "corner style of rect, hexagon and rhombus"
              }
             },
             "description": "Create or change a node type; only given fields change. bg and fg are set together and need contrast >= 4.5:1."
            },
            {
             "type": "object",
             "required": [
              "op",
              "name"
             ],
             "properties": {
              "op": {
               "const": "upsert_edge_type"
              },
              "name": {
               "type": "string"
              },
              "new_name": {
               "type": "string"
              },
              "label": {
               "type": "string"
              },
              "color": {
               "type": "string",
               "description": "#rrggbb"
              },
              "text_color": {
               "type": "string",
               "description": "#rrggbb"
              },
              "width": {
               "type": "integer",
               "description": "clamped to 1-10"
              },
              "line_style": {
               "type": "string",
               "enum": [
                "solid",
                "dashed",
                "dotted"
               ]
              },
              "start": {
               "type": "string",
               "enum": [
                "none",
                "arrow",
                "dot",
                "bar"
               ]
              },
              "end": {
               "type": "string",
               "enum": [
                "none",
                "arrow",
                "dot",
                "bar"
               ]
              }
             },
             "description": "Create or change an edge type. color needs contrast >= 3:1 and text_color >= 4.5:1 against the graph background."
            },
            {
             "type": "object",
             "required": [
              "op",
              "name"
             ],
             "properties": {
              "op": {
               "const": "remove_node_type"
              },
              "name": {
               "type": "string"
              }
             }
            },
            {
             "type": "object",
             "required": [
              "op",
              "name"
             ],
             "properties": {
              "op": {
               "const": "remove_edge_type"
              },
              "name": {
               "type": "string"
              }
             }
            }
           ],
           "discriminator": {
            "propertyName": "op"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
